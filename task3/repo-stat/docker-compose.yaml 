version: '3.8'

services:
  # API Gateway
  api:
    build:
      context: .
      dockerfile: Dockerfile.api
    container_name: repo-stat-api
    ports:
      - "8080:8080"
    environment:
      - PROCESSOR_ADDRESS=processor:50051
      - SUBSCRIBER_ADDRESS=subscriber:8081
    depends_on:
      - processor
      - subscriber
    networks:
      - repo-stat-network

  # Processor Service
  processor:
    build:
      context: .
      dockerfile: Dockerfile.processor
    container_name: repo-stat-processor
    ports:
      - "50051:50051"
    environment:
      - COLLECTOR_ADDRESS=collector:50052
    depends_on:
      - collector
    networks:
      - repo-stat-network

  # Collector Service
  collector:
    build:
      context: .
      dockerfile: Dockerfile.collector
    container_name: repo-stat-collector
    ports:
      - "50052:50052"
    environment:
      - GITHUB_TOKEN=${GITHUB_TOKEN:-}
    networks:
      - repo-stat-network

  # Subscriber Service
  subscriber:
    build:
      context: .
      dockerfile: Dockerfile.subscriber
    container_name: repo-stat-subscriber
    ports:
      - "8081:8081"
    networks:
      - repo-stat-network

networks:
  repo-stat-network:
    driver: bridge