FROM golang:1.25 AS build

RUN apk add --no-cache git

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY api ./api
COPY platform ./platform
COPY proto ./proto

ENV CGO_ENABLED=0
RUN go build -o /api ./api/cmd/app/main.go

FROM alpine:latest
RUN apk add --no-cache ca-certificates
COPY --from=build /api /api
COPY api/config/config.yaml /config.yaml

ENTRYPOINT ["/api", "-config", "/config.yaml"]
